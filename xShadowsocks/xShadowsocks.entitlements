<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately empty so this target can be signed with a free Apple Developer
	     account. The app runs the core in loopback mode, which needs no entitlement.

	     On a paid account, add these to use system-wide tunnelling instead:
	         <key>com.apple.security.application-groups</key>
	         <array><string>group.com.github.iappapp.xShadowsocks</string></array>
	         <key>com.apple.developer.networking.networkextension</key>
	         <array><string>packet-tunnel-provider</string></array>
	     Keep the App Group identical in xPacketTunnel.entitlements, and set
	     AppGroupStore.appGroupID to the same value. -->
</dict>
</plist>
